# EPR Compliance Copilot - Environment Configuration
# Copy this to .env and fill in one or more API keys to activate LIVE mode.
# Without any key, the app runs in MOCK MODE (zero cost, zero setup).
#
# Provider priority (first filled key wins):
#   1. AWS BEDROCK  →  2. GROQ  →  3. OPENROUTER  →  4. GEMINI  →  5. ANTHROPIC  →  6. OPENAI
#
# To force a specific provider when multiple keys are set:
# LLM_PROVIDER=bedrock    # options: bedrock | groq | openrouter | gemini | anthropic | openai

# ─────────────────────────────────────────────────────────────────────────────
# 1. AMAZON BEDROCK (AWS Build Bharat Native Enterprise Stack)
#    Configure AWS IAM credentials or run on EC2/ECS/Lambda with IAM Role
# ─────────────────────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Alternative Bedrock Models:
# BEDROCK_MODEL_ID=amazon.titan-text-express-v1
# BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0

# ─────────────────────────────────────────────────────────────────────────────
# 2. GROQ  (Recommended for Local Dev — FREE tier, ultra-fast LPU inference)
#    Get key: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# Active FREE models on Groq (Sep 2026) — uncomment one to override default:
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-20b            # Fast & lightweight, free
# GROQ_MODEL=openai/gpt-oss-120b           # Large reasoning model, free

# ─────────────────────────────────────────────────────────────────────────────
# 2. OPENROUTER  (FREE :free models, multi-provider gateway)
#    Get key: https://openrouter.ai/keys
#    Browse free models: https://openrouter.ai/models?q=:free
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Active FREE models on OpenRouter (Sep 2026) — all use :free suffix:
OPENROUTER_MODEL=deepseek/deepseek-r1:free
# OPENROUTER_MODEL=qwen/qwq-32b:free                     # Qwen reasoning, free
# OPENROUTER_MODEL=google/gemma-3-27b-it:free            # Google Gemma 3, free
# OPENROUTER_MODEL=deepseek/deepseek-chat:free           # DeepSeek V3 chat, free
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free    # Lightweight, very fast, free

# ─────────────────────────────────────────────────────────────────────────────
# 3. GOOGLE GEMINI
#    Get key: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# GOOGLE_API_KEY=      # alternative variable name, same effect
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# 4. ANTHROPIC CLAUDE
#    Get key: https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─────────────────────────────────────────────────────────────────────────────
# 5. OPENAI
#    Get key: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# Optional: LangSmith tracing (for RAG evaluation & quality monitoring)
#    Get key: https://smith.langchain.com/settings
# ─────────────────────────────────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=epr-copilot
